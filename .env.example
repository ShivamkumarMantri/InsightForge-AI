# Google Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backend Configuration (FastAPI on Render)
MAX_UPLOAD_MB=25
# Comma-separated allowed origins (e.g. your deployed Vercel domain, or * for all)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app

# Frontend Configuration (Vercel deployment)
# Set in Vercel Project Settings > Environment Variables:
# VITE_API_URL=https://your-service.onrender.com
